---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="CV — Yoel Lazarte">
  <Navbar />
  <main>
    <section class="max-w-shell mx-auto px-[18px] md:px-[25px] pt-8">
      <div class="flex items-center justify-between flex-wrap gap-2.5">
        <SectionTitle>Curriculum</SectionTitle>
        <a href="/resume/resume.pdf" download
          class="font-ui text-[0.8rem] font-medium bg-surface-card border border-line rounded-lg2 px-4 py-2 shadow-sm2 hover:border-line-hover transition-colors duration-200">
          Descargar PDF
        </a>
      </div>

      <p class="font-body text-[0.8rem] text-ink-dim mt-1.5 mb-[18px]">
        Este es un PDF de marcador de posición — se reemplaza en <code class="font-mono bg-surface-elevated px-1.5 py-0.5 rounded-sm2">public/resume/resume.pdf</code>.
      </p>

      <div class="dash-box overflow-hidden h-[70vh]">
        <iframe src="/resume/resume.pdf" title="CV de Yoel Lazarte" loading="lazy" class="w-full h-full border-none bg-white"></iframe>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
