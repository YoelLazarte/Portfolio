---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 — Yoel Lazarte">
  <Navbar />
  <main class="relative overflow-hidden">
    <!-- slow drifting dot grid behind the error -->
    <div aria-hidden="true" class="absolute -inset-10 pointer-events-none opacity-40 animate-drift
      bg-[radial-gradient(circle,#333_1px,transparent_1px)] [background-size:28px_28px]
      [mask-image:radial-gradient(ellipse_at_center,#000_30%,transparent_70%)]"></div>

    <section class="relative max-w-shell mx-auto px-[18px] min-h-[60vh] flex flex-col items-center justify-center text-center gap-2.5 animate-slide-up">
      <p class="font-ui font-bold text-[clamp(3.5rem,12vw,8rem)] leading-none text-ink m-0 tracking-[-0.02em] animate-glow">404</p>
      <h1 class="font-ui text-[1.3rem] text-ink m-0 tracking-[-0.01em] animate-fade-in [animation-delay:0.2s]">Esta página no existe</h1>
      <p class="font-body text-[0.9rem] text-ink-dim mb-3.5 animate-fade-in [animation-delay:0.4s]">El link puede estar roto o la página se movió.</p>
      <div class="flex gap-2.5 flex-wrap justify-center animate-fade-in [animation-delay:0.6s]">
        <a href="/" class="font-ui text-[0.85rem] font-medium bg-surface-card text-ink rounded-lg2 px-5 py-2.5 shadow-btn hover:shadow-btn-hover transition-shadow duration-300">
          Volver al inicio
        </a>
        <a href="/proyectos" class="font-ui text-[0.85rem] font-medium border border-line rounded-lg2 px-5 py-2.5 text-ink-secondary hover:text-ink hover:border-line-hover transition-colors duration-200">
          Ver proyectos
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
