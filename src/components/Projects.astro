---
import SectionTitle from './SectionTitle.astro';
import ProjectCard from './ProjectCard.astro';
import { featuredProjects } from '../data/projects';
---

<section class="max-w-shell mx-auto px-[18px] md:px-[25px] py-2" id="proyectos">
  <div class="flex items-center justify-between mb-1">
    <SectionTitle>Proyectos</SectionTitle>
    <a href="/proyectos" class="font-ui text-[0.78rem] font-medium bg-surface-card border border-line rounded-sm2 px-3.5 py-1.5 shadow-sm2 hover:border-line-hover transition-colors duration-200">Ver todos →</a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
    {featuredProjects.map(p => <ProjectCard project={p} />)}
  </div>
</section>
