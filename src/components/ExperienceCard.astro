---
import type { ExperienceEntry } from '../data/experience';

interface Props {
  entry: ExperienceEntry;
  isLast?: boolean;
}
const { entry, isLast = false } = Astro.props;
const statusLabel = entry.status === 'present' ? 'Actual' : 'Anterior';
const isPresent = entry.status === 'present';
---

<div class="flex gap-3.5">
  <div class="flex flex-col items-center w-3 flex-shrink-0">
    <span class={`w-2.5 h-2.5 rounded-full mt-[18px] flex-shrink-0 ${isPresent ? 'bg-state-active shadow-[0_0_0_4px_rgba(2,255,103,0.5)] animate-pulse-dot' : 'bg-state-past shadow-[0_0_0_4px_rgba(255,51,51,0.5)]'}`}></span>
    {!isLast && <span class="flex-1 w-px border-l border-dashed border-ink-dim mt-1"></span>}
  </div>

  <details class="dash-box flex-1 mb-4">
    <summary class="list-none cursor-pointer p-3.5 [&::-webkit-details-marker]:hidden">
      <div class="flex items-center justify-between mb-1">
        <span class="font-ui font-semibold text-base text-ink">{entry.company}</span>
        <span class={`font-ui text-[0.65rem] font-medium px-2 py-0.5 rounded-full ${isPresent ? 'text-state-active bg-state-activebg' : 'text-state-past bg-state-pastbg'}`}>{statusLabel}</span>
      </div>
      <p class="font-ui text-[0.85rem] text-state-role m-0 mb-0.5 font-medium">{entry.role}</p>
      <p class="font-mono text-xs text-ink-dim m-0">{entry.dates}</p>
    </summary>

    <div class="px-3.5 pb-3.5">
      <ul class="m-0 pl-4">
        {entry.description.map(d => <li class="font-body text-sm text-ink-secondary leading-relaxed mb-1">{d}</li>)}
      </ul>
      {entry.links && entry.links.length > 0 && (
        <div class="mt-2 flex gap-2.5">
          {entry.links.map(l => (
            <a href={l.url} target="_blank" rel="noopener" class="font-ui text-[0.8rem] text-brand-blue hover:text-brand-bluehover">{l.label} ↗</a>
          ))}
        </div>
      )}
    </div>
  </details>
</div>
