---
import Icon from './Icon.astro';
import { socialLinks } from '../data/socialLinks';
---

<footer class="max-w-shell mx-auto px-[18px] py-[30px] pb-10 text-center border-t border-dashed border-line/60 mt-10">
  <div class="flex items-center justify-center gap-2 mb-4">
    {socialLinks.map(s => (
      <a href={s.url} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener" aria-label={s.name} data-tooltip={s.name}
        class="w-8 h-8 rounded-full flex items-center justify-center text-ink-dim hover:text-ink hover:bg-surface-card transition-colors duration-200">
        <Icon name={s.icon} size={14} />
      </a>
    ))}
  </div>

  <p class="font-ui italic text-[0.85rem] text-ink-dim mb-3">"Construido con Astro, café y paciencia."</p>
  <div class="flex items-center justify-center gap-3.5 flex-wrap font-mono text-[0.7rem] text-ink-ghost">
    <span class="inline-flex items-center gap-1">
      © {new Date().getFullYear()} · Diseñado y hecho con
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-label="amor" role="img"
        class="text-red-600 animate-heart-beat transition-[color,filter] duration-300 hover:text-[rgb(190,29,29)] hover:drop-shadow-[0_0_6px_#e63946aa]">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
      por Yoel Lazarte
    </span>
    <span id="clock" class="tabular-nums">—:—:— ART</span>
  </div>
</footer>

<button id="back-to-top" aria-label="Volver arriba"
  class="fixed bottom-5 right-5 z-[999] w-9 h-9 rounded-full flex items-center justify-center bg-surface-card border border-line text-ink-secondary shadow-btn hover:text-ink hover:border-line-hover opacity-0 pointer-events-none translate-y-2 transition-all duration-300">
  <span class="-rotate-90 flex"><Icon name="arrow-right" size={15} /></span>
</button>

<script>
  const clock = document.getElementById('clock');
  function tick() {
    if (!clock) return;
    const now = new Date().toLocaleTimeString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hour12: false });
    clock.textContent = `${now} ART`;
  }
  tick();
  setInterval(tick, 1000);

  const toTop = document.getElementById('back-to-top');
  const onScroll = () => {
    const show = window.scrollY > 600;
    toTop?.classList.toggle('opacity-0', !show);
    toTop?.classList.toggle('pointer-events-none', !show);
    toTop?.classList.toggle('translate-y-2', !show);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  toTop?.addEventListener('click', () => window.scrollTo({ top: 0 }));
</script>
