<footer class="max-w-shell mx-auto px-[18px] py-[30px] pb-10 text-center">
  <p class="font-ui italic text-[0.85rem] text-ink-dim mb-3">"Construido con Astro, café y paciencia."</p>
  <div class="flex items-center justify-center gap-3.5 flex-wrap font-mono text-[0.7rem] text-ink-ghost">
    <span>Diseñado y hecho por Yoel Lazarte</span>
    <span id="clock" class="tabular-nums">—:—:— ART</span>
  </div>
</footer>

<script>
  const clock = document.getElementById('clock');
  function tick() {
    if (!clock) return;
    const now = new Date().toLocaleTimeString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hour12: false });
    clock.textContent = `${now} ART`;
  }
  tick();
  setInterval(tick, 1000);
</script>
