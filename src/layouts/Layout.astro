---
import '../style/global.css';
import ClickSpark from '../components/ClickSpark.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yoel Lazarte — Full Stack Developer',
  description = 'Desarrollo productos digitales, sistemas web y automatizaciones para convertir ideas y procesos en soluciones reales. Vue.js, React, Laravel, n8n.',
} = Astro.props;

// Astro.site is undefined until `site` is set in astro.config.mjs — fall back to the request URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL('/preview.png', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0b0d0e" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Yoel Lazarte',
      jobTitle: 'Full Stack Developer',
      url: canonicalURL.toString(),
      email: 'mailto:yoelazarte04@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
      sameAs: ['https://linkedin.com/in/yoel-lazarte/', 'https://github.com/YoelLazarte'],
    })} />
  </head>
  <body>
    <slot />
    <ClickSpark sparkSize={12} sparkRadius={20} />

    <script>
      // Fade-in on scroll for any element marked with [data-reveal]
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -60px 0px' });
      targets.forEach((t) => io.observe(t));
    </script>
  </body>
</html>
