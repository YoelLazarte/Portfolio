---
import '../style/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yoel Lazarte — Full Stack Developer',
  description = 'Desarrollo productos digitales, sistemas web y automatizaciones para convertir ideas y procesos en soluciones reales. Vue.js, React, Laravel, n8n.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Yoel Lazarte',
      jobTitle: 'Full Stack Developer',
      url: canonicalURL.toString(),
      email: 'mailto:yoelazarte04@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
      sameAs: ['https://linkedin.com/in/yoel-lazarte/', 'https://github.com/YoelLazarte'],
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
